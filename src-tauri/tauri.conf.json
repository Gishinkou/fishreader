{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mini Reader",
  "version": "0.1.0",
  "identifier": "com.fishreader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mini Reader",
        "width": 420,
        "height": 620,
        "minWidth": 340,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": ["resources/articles/**/*.md"]
  }
}